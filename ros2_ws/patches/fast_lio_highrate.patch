diff --git a/src/preprocess.cpp b/src/preprocess.cpp
index 88444f4..b4a182a 100644
--- a/src/preprocess.cpp
+++ b/src/preprocess.cpp
@@ -3,0 +4,2 @@
+#include <algorithm>
+#include <cmath>
@@ -49 +51,2 @@ void Preprocess::process(const livox_ros_driver2::msg::CustomMsg::UniquePtr &msg
-  avia_handler(msg);
+  if (mid360s_mode) mid360s_handler(msg);
+  else avia_handler(msg);
@@ -52,0 +56,29 @@ void Preprocess::process(const livox_ros_driver2::msg::CustomMsg::UniquePtr &msg
+void Preprocess::mid360s_handler(const livox_ros_driver2::msg::CustomMsg::UniquePtr &msg)
+{
+  pl_surf.clear();
+  if (feature_enabled || point_filter_num <= 0) return;
+  pl_surf.reserve(msg->points.size() / point_filter_num + 1);
+  std::size_t valid = 0;
+  for (const auto &raw : msg->points)
+  {
+    // MID360S tag: each two-bit confidence must be 0 or 1; bits 7:6 reserved.
+    const auto tag = raw.tag;
+    if ((tag & 0xC0U) != 0U || ((tag >> 4U) & 3U) >= 2U ||
+        ((tag >> 2U) & 3U) >= 2U || (tag & 3U) >= 2U) continue;
+    const double range_sq = double(raw.x) * raw.x + double(raw.y) * raw.y + double(raw.z) * raw.z;
+    if (!std::isfinite(raw.x) || !std::isfinite(raw.y) || !std::isfinite(raw.z) ||
+        !std::isfinite(range_sq) || range_sq <= blind * blind) continue;
+    if (valid++ % static_cast<std::size_t>(point_filter_num) != 0U) continue;
+    PointType point{};
+    point.x = raw.x;
+    point.y = raw.y;
+    point.z = raw.z;
+    point.intensity = raw.reflectivity;
+    point.curvature = static_cast<float>(double(raw.offset_time) * 1e-6);
+    pl_surf.push_back(point);
+  }
+  // Undistortion expects time-ordered points; filtering must not change frame end.
+  std::stable_sort(pl_surf.points.begin(), pl_surf.points.end(),
+                   [](const PointType &a, const PointType &b) { return a.curvature < b.curvature; });
+}
+
