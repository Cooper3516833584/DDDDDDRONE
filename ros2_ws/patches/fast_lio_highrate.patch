+                             const sensor_msgs::msg::Imu::ConstSharedPtr &cur_imu,
+                             esekfom::esekf<state_ikfom, 12, input_ikfom> &filter,
+                             V3D &gyr_unbiased, double max_dt = 0.1) const;
@@ -155,0 +162,29 @@ void ImuProcess::set_acc_bias_cov(const V3D &b_a)
+bool ImuProcess::PredictHighRateFilter(
+    const sensor_msgs::msg::Imu::ConstSharedPtr &last_imu,
+    const sensor_msgs::msg::Imu::ConstSharedPtr &cur_imu,
+    esekfom::esekf<state_ikfom, 12, input_ikfom> &filter,
+    V3D &gyr_unbiased, double max_dt) const
+{
+  if (imu_need_init_ || !last_imu || !cur_imu || mean_acc.norm() < 1e-6)
+    return false;
+  double dt = rclcpp::Time(cur_imu->header.stamp).seconds() -
+              rclcpp::Time(last_imu->header.stamp).seconds();
+  if (dt <= 0.0 || dt > max_dt) return false;
+  input_ikfom in;
+  in.gyro << 0.5 * (last_imu->angular_velocity.x + cur_imu->angular_velocity.x),
+             0.5 * (last_imu->angular_velocity.y + cur_imu->angular_velocity.y),
+             0.5 * (last_imu->angular_velocity.z + cur_imu->angular_velocity.z);
+  in.acc << 0.5 * (last_imu->linear_acceleration.x + cur_imu->linear_acceleration.x),
+            0.5 * (last_imu->linear_acceleration.y + cur_imu->linear_acceleration.y),
+            0.5 * (last_imu->linear_acceleration.z + cur_imu->linear_acceleration.z);
+  in.acc *= G_m_s2 / mean_acc.norm();
+  Eigen::Matrix<double, 12, 12> noise = process_noise_cov();
+  noise.block<3, 3>(0, 0).diagonal() = cov_gyr;
+  noise.block<3, 3>(3, 3).diagonal() = cov_acc;
+  noise.block<3, 3>(6, 6).diagonal() = cov_bias_gyr;
+  noise.block<3, 3>(9, 9).diagonal() = cov_bias_acc;
+  filter.predict(dt, noise, in);
+  gyr_unbiased = in.gyro - filter.get_x().bg;
+  return true;
+}
