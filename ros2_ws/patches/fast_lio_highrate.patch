--- a/src/IMU_Processing.hpp
+++ b/src/IMU_Processing.hpp
@@ -50,0 +51,5 @@ class ImuProcess
+  bool imu_ready() const { return !imu_need_init_; }
+  bool PropagateHighRateState(const sensor_msgs::msg::Imu::ConstSharedPtr &last_imu,
+                              const sensor_msgs::msg::Imu::ConstSharedPtr &cur_imu,
+                              state_ikfom &state_io, V3D &gyr_unbiased,
+                              double max_dt = 0.1);
@@ -155,0 +161,28 @@ void ImuProcess::set_acc_bias_cov(const V3D &b_a)
+bool ImuProcess::PropagateHighRateState(
+    const sensor_msgs::msg::Imu::ConstSharedPtr &last_imu,
+    const sensor_msgs::msg::Imu::ConstSharedPtr &cur_imu,
+    state_ikfom &state_io, V3D &gyr_unbiased, double max_dt)
+{
+  if (imu_need_init_ || !last_imu || !cur_imu) return false;
+  const double dt = rclcpp::Time(cur_imu->header.stamp).seconds() -
+                    rclcpp::Time(last_imu->header.stamp).seconds();
+  if (dt <= 0.0 || dt > max_dt || mean_acc.norm() < 1e-6) return false;
+
+  const V3D gyr_avr(
+      0.5 * (last_imu->angular_velocity.x + cur_imu->angular_velocity.x),
+      0.5 * (last_imu->angular_velocity.y + cur_imu->angular_velocity.y),
+      0.5 * (last_imu->angular_velocity.z + cur_imu->angular_velocity.z));
+  V3D acc_avr(
+      0.5 * (last_imu->linear_acceleration.x + cur_imu->linear_acceleration.x),
+      0.5 * (last_imu->linear_acceleration.y + cur_imu->linear_acceleration.y),
+      0.5 * (last_imu->linear_acceleration.z + cur_imu->linear_acceleration.z));
+  acc_avr *= G_m_s2 / mean_acc.norm();
+  gyr_unbiased = gyr_avr - state_io.bg;
+  V3D acc_world = state_io.rot * (acc_avr - state_io.ba);
+  for (int i = 0; i < 3; ++i) acc_world[i] += state_io.grav[i];
+  state_io.pos += state_io.vel * dt + 0.5 * acc_world * dt * dt;
+  state_io.vel += acc_world * dt;
+  state_io.rot = SO3(state_io.rot.toRotationMatrix() * Exp(gyr_unbiased, dt));
+  return true;
+}
+
